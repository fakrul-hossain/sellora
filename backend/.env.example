# SELLORA Backend Environment Variables

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sellora_db
DB_SSL=false
DB_CONNECTION_LIMIT=20

# Authentication (JWT)
JWT_SECRET=sellora_default_dev_secret_key_change_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=sellora_default_dev_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Mailer Configuration (Optional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@sellora.com

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
