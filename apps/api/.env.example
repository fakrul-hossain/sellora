# Server Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB Native Driver)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sellora_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Security & JWT
JWT_SECRET=super_secret_sellora_jwt_key_32_bytes_min
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_sellora_refresh_key_32_bytes_min
JWT_REFRESH_EXPIRES_IN=30d

# Mail Service
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_username
MAIL_PASS=your_mail_password
MAIL_FROM=no-reply@sellora.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (Queue & Caching ready)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
